# Copier ce fichier en `.env` et renseigner les valeurs (le `.env` réel n'est
# pas versionné). Le site est une vitrine statique : aucune de ces variables
# n'est nécessaire au build ni à l'affichage. Elles ne servent que si le client
# Supabase de `src/integrations/supabase/` est un jour réellement appelé.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Renseignée automatiquement par le workflow GitHub Pages. À définir à la main
# seulement pour reproduire le build de production en local.
# VITE_SITE_URL=https://alexandra-et-thomas.fr
